# Copy to .env. .env is git-ignored — never commit real secrets.

# For running the app directly on your machine against the Docker-run
# Postgres from Stage 0 (docker run ... -p 5432:5432 ...):
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Inside docker-compose, the app reaches Postgres by service name, not
# localhost — docker-compose.yml already sets this for you as:
#   postgres://postgres:dev@db:5432/tasks
# You only need the localhost version above for running `uvicorn` directly.

# Which repository backend to use: "postgres" or "memory"
REPOSITORY_BACKEND=postgres
